# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing

# JWT for admin auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=Gatewave <onboarding@resend.dev>

# Frontend base URL (for links in emails, payment redirects, live stream links)
# Local dev:
FRONTEND_BASE_URL=http://localhost:5173
# Production (set on Render): FRONTEND_BASE_URL=https://gatewav.com

# Manual bank transfer details (shown at checkout; change anytime and restart)
MANUAL_PAYMENT_ACCOUNT_NAME=AFRESH BIZ & ENT LTD
MANUAL_PAYMENT_ACCOUNT_NUMBER=5080265397
MANUAL_PAYMENT_BANK_NAME=Fidelity bank
MANUAL_PAYMENT_CONTACT_URL=https://wa.link/7lo5b5
# Email destination for "I have paid" manual payment notifications
MANUAL_PAYMENT_NOTIFY_EMAIL=williambosworth777@icloud.com

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (ticket checkout + admin withdrawal payouts)
PAYSTACK_SECRET_KEY=
# Set to 1 in local dev to skip live Paystack initialize (mock redirect URL)
# PAYSTACK_MOCK_INIT=0

# Optional: set to 1 only if you get "self-signed certificate in certificate chain"
# when the server sends email (Resend). Insecure; use only in dev or behind proxy.
# ALLOW_INSECURE_TLS_OUTBOUND=0
