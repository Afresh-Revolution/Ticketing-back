# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing

# JWT for admin auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=Gatewave <onboarding@resend.dev>

# Frontend base URL (for links in emails)
FRONTEND_BASE_URL=http://localhost:5173

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set to 1 only if you get "self-signed certificate in certificate chain"
# when the server sends email (Resend). Insecure; use only in dev or behind proxy.
# ALLOW_INSECURE_TLS_OUTBOUND=0
