# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing

# JWT for admin auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=Gatewave <onboarding@resend.dev>

# Frontend base URL (for links in emails: receipt, organizer form)
FRONTEND_BASE_URL=http://localhost:5173

# Paystack (for membership verification)
PAYSTACK_SECRET_KEY=
